---
import { cms } from '../lib/cms'

interface Props {
  title: string
  description?: string
  lang?: string
  preview?: boolean
}

const { title, description, lang = 'en', preview = false } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {preview && <script is:inline src={`${cms.origin}/bridge.js`} defer></script>}
  </head>
  <body>
    <slot />
  </body>
</html>
